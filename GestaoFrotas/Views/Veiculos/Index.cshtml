@model IEnumerable<GestaoFrotas.Models.Veiculo>

@{
    ViewData["Title"] = "Veículos";
}

<h1>Veículos</h1>

<table class="table">
    <thead>
        <tr>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Ano</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var veiculo in Model)
        {
            <tr>
                <td>@veiculo.Placa</td>
                <td>@veiculo.Marca</td>
                <td>@veiculo.Modelo</td>
                <td>@veiculo.Ano</td>
                <td>@veiculo.Status</td>
            </tr>
        }
    </tbody>
</table>